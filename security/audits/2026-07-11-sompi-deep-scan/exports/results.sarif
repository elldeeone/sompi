        {
          "level": "warning",
          "locations": [
            {
              "message": {
                "text": "propagation"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/policy.ts"
                },
                "region": {
                  "endLine": 74,
                  "startLine": 43
                }
              }
            }
          ],
          "message": {
            "text": "Sompi treats the file named by `SOMPI_POLICY` as an operator-owned control below the untrusted Agent. At revision `4ebb82d4f82bac46ae3addd112c4752f29630a8a` (package version `0.8.0`), `PolicyEngine` reads that file and hot-reloads it by pathname without checking whether it is a symbolic link, a regular file, owned by a trusted operator, non-writable by the Agent principal, or reached through protected ancestors. Both `statSync` and `readFileSync` follow symbolic links. Consequently, a lower-privilege local Agent-side process that can write or replace the configured leaf, a followed target, or a relevant ancestor can supply valid permissive policy JSON. On the next policy access, Sompi promotes those bytes into the active direct-spend policy. The Agent can then use the ordinary `send_payment` MCP tool to ask the credential-bearing Sompi process to prepare, sign, and submit an attacker-directed wallet transaction."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:d1b3d1959990b234e566b6270baef0361c15e19f3f078a1a1aeff68f7663a33b"

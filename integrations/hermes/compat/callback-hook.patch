diff --git a/tests/gateway/test_plugin_callback_query.py b/tests/gateway/test_plugin_callback_query.py
new file mode 100644
index 000000000..e4f271969
--- /dev/null
+++ b/tests/gateway/test_plugin_callback_query.py
@@ -0,0 +1,129 @@
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from gateway.plugin_callbacks import (
+    PluginCallbackResult,
+    dispatch_plugin_callback_query,
+)
+
+
+def test_plugin_callback_dispatch_requires_one_exact_owner():
+    manager = MagicMock()
+    manager.has_hook.return_value = True
+    with (
+        patch("hermes_cli.plugins.get_plugin_manager", return_value=manager),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[
+            {"action": "unhandled"},
+            {"action": "handled", "status": "approved", "message": "Approved."},
+        ]),
+    ):
+        assert dispatch_plugin_callback_query(
+            platform="telegram",
+            callback_data="external:value",
+            user_id="1",
+            chat_id="2",
+            thread_id=None,
+            chat_type="private",
+        ) == PluginCallbackResult(status="approved", message="Approved.")
+
+    with (
+        patch("hermes_cli.plugins.get_plugin_manager", return_value=manager),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[
+            {"action": "handled", "status": "approved", "message": "First"},
+            {"action": "handled", "status": "denied", "message": "Second"},
+        ]),
+    ):
+        assert dispatch_plugin_callback_query(
+            platform="telegram",
+            callback_data="external:value",
+            user_id="1",
+            chat_id="2",
+            thread_id=None,
+            chat_type="private",
+        ).status == "error"
+
+
+@pytest.mark.asyncio
+async def test_telegram_forwards_authorized_unknown_callback_to_plugin():
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+
+    adapter = object.__new__(TelegramAdapter)
+    adapter._is_callback_user_authorized = MagicMock(return_value=True)
+    query = MagicMock()
+    query.data = "sp:a:opaque"
+    query.from_user.id = 123
+    query.from_user.first_name = "Luke"
+    query.message.chat_id = 456
+    query.message.chat.type = "private"
+    query.message.message_thread_id = None
+    query.answer = AsyncMock()
+    query.edit_message_text = AsyncMock()
+    update = MagicMock(callback_query=query)
+
+    with patch(
+        "gateway.plugin_callbacks.dispatch_plugin_callback_query",
+        return_value=PluginCallbackResult(status="approved", message="Sompi Purchase approved."),
+    ) as dispatch:
+        await TelegramAdapter._handle_callback_query(adapter, update, MagicMock())
+
+    dispatch.assert_called_once_with(
+        platform="telegram",
+        callback_data="sp:a:opaque",
+        user_id="123",
+        chat_id="456",
+        thread_id=None,
+        chat_type="private",
+    )
+    query.answer.assert_awaited_once_with(text="Sompi Purchase approved.")
+    query.edit_message_text.assert_awaited_once_with(
+        text="Sompi Purchase approved.",
+        reply_markup=None,
+    )
+
+
+@pytest.mark.asyncio
+async def test_telegram_rejects_unauthorized_external_callback_before_plugin():
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+
+    adapter = object.__new__(TelegramAdapter)
+    adapter._is_callback_user_authorized = MagicMock(return_value=False)
+    query = MagicMock()
+    query.data = "sp:a:opaque"
+    query.from_user.id = 999
+    query.from_user.first_name = "Mallory"
+    query.message.chat_id = 456
+    query.message.chat.type = "private"
+    query.message.message_thread_id = None
+    query.answer = AsyncMock()
+    update = MagicMock(callback_query=query)
+
+    with patch("gateway.plugin_callbacks.dispatch_plugin_callback_query") as dispatch:
+        await TelegramAdapter._handle_callback_query(adapter, update, MagicMock())
+
+    dispatch.assert_not_called()
+    query.answer.assert_awaited_once_with(text="⛔ You are not authorized to use this control.")
+
+
+@pytest.mark.asyncio
+async def test_telegram_keeps_builtin_update_callbacks_out_of_plugin_dispatch():
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+
+    adapter = object.__new__(TelegramAdapter)
+    adapter._is_callback_user_authorized = MagicMock(return_value=True)
+    query = MagicMock()
+    query.data = "update_prompt:y"
+    query.from_user.id = 123
+    query.from_user.first_name = "Luke"
+    query.message.chat_id = 456
+    query.message.chat.type = "private"
+    query.message.message_thread_id = None
+    query.answer = AsyncMock()
+    query.edit_message_text = AsyncMock()
+    update = MagicMock(callback_query=query)
+
+    with patch("gateway.plugin_callbacks.dispatch_plugin_callback_query") as dispatch:
+        await TelegramAdapter._handle_callback_query(adapter, update, MagicMock())
+
+    dispatch.assert_not_called()
+    query.answer.assert_awaited_once_with(text="Sent 'y' to the update process.")

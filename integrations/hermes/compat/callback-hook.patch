+"""Strict dispatch for plugin-owned messaging callback queries."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Optional
+
+
+_VALID_STATUSES = {
+    "approved",
+    "denied",
+    "expired",
+    "replayed",
+    "unauthorized",
+    "invalid",
+    "error",
+}
+
+
+@dataclass(frozen=True)
+class PluginCallbackResult:
+    status: str
+    message: str
+
+
+def dispatch_plugin_callback_query(
+    *,
+    platform: str,
+    callback_data: str,
+    user_id: str,
+    chat_id: str,
+    thread_id: Optional[str],
+    chat_type: Optional[str],
+) -> Optional[PluginCallbackResult]:
+    """Invoke the generic callback hook and require one unambiguous owner."""
+    from hermes_cli.plugins import get_plugin_manager, invoke_hook
+
+    manager = get_plugin_manager()
+    if not manager.has_hook("gateway_callback_query"):
+        return None
+    results = invoke_hook(
+        "gateway_callback_query",
+        platform=platform,
+        callback_data=callback_data,
+        user_id=user_id,
+        chat_id=chat_id,
+        thread_id=thread_id,
+        chat_type=chat_type,
+    )
+    handled: list[PluginCallbackResult] = []
+    invalid = False
+    for value in results:
+        if not isinstance(value, dict):
+            invalid = True
+            continue
+        action = value.get("action")
+        if action == "unhandled" and set(value) == {"action"}:
+            continue
+        if action != "handled" or set(value) != {"action", "status", "message"}:
+            invalid = True
+            continue
+        status = value.get("status")
+        message = value.get("message")
+        if (
+            not isinstance(status, str)
+            or status not in _VALID_STATUSES
+            or not isinstance(message, str)
+            or not 1 <= len(message) <= 200
+            or any(ord(char) < 0x20 and char not in "\t" for char in message)
+        ):
+            invalid = True
+            continue
+        handled.append(PluginCallbackResult(status=status, message=message))
+    if invalid or len(handled) > 1 or (not results and manager.has_hook("gateway_callback_query")):
+        return PluginCallbackResult(
+            status="error",
+            message="This external action could not be processed safely.",
+        )
+    return handled[0] if handled else None

     "pre_gateway_dispatch",
+    # Gateway callback-query hook for standalone plugins that render their own
+    # inline controls. Telegram invokes it only after built-in callback
+    # namespaces have been excluded and platform authorization has passed.
+    # Callbacks receive sanitized scalar metadata and must return exactly one
+    # of {"action": "unhandled"} or
+    # {"action": "handled", "status": str, "message": str}.
+    "gateway_callback_query",
     # Approval lifecycle hooks. Fired by tools/approval.py when a dangerous
     # command needs an approval decision -- fires for CLI-interactive prompts,
     # gateway/ACP approvals, and smart-mode auxiliary-LLM decisions.

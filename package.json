{
  "name": "@elldeeone/sompi",
  "version": "0.6.1",
  "description": "Sompi — the agent payment kit for Kaspa. MCP server with policy-enforced wallet tools, Toccata-native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elldeeone/sompi.git"
  },
  "keywords": [
    "kaspa",
    "mcp",
    "agent",
    "payments",
    "micropayments",
    "model-context-protocol"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "sompi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "vendor/kaspa-wasm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "fixtures:vault": "node scripts/compile-vault-fixtures.js",
    "fixtures:vault:check": "node scripts/compile-vault-fixtures.js --check",
    "fixtures:escrow": "node scripts/compile-escrow-fixtures.js",
    "fixtures:escrow:check": "node scripts/compile-escrow-fixtures.js --check",
    "demo:escrow": "node dist/demo-escrow.js",
    "proof:vault": "node scripts/vault-live.js",
    "proof:vault-commerce": "node scripts/vault-commerce-live.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "websocket": "^1.0.35",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/websocket": "^1.0.10",
    "typescript": "^5.6.0"
  }
}

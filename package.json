{
  "name": "@elldeeone/sompi",
  "version": "0.7.0",
  "description": "Sompi — the agent payment kit for Kaspa. MCP server with policy-enforced wallet tools, Toccata-native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elldeeone/sompi.git"
  },
  "keywords": [
    "kaspa",
    "mcp",
    "agent",
    "payments",
    "micropayments",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sompi-mcp": "dist/index.js"
  },
  "files": [
    "contracts",
    "deploy",
    "dist",
    "docs/agent-interaction-ux.md",
    "docs/escrow-poc.md",
    "docs/kaspa-escrow-x402.md",
    "docs/mainnet-readiness.md",
    "docs/vault-poc.md",
    "policy.example.json",
    "scripts",
    "vendor/kaspa-wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && npm run test:unit && SOMPI_SMOKE_OFFLINE=1 npm run smoke",
    "test:unit": "node scripts/run-unit-tests.js",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "fixtures:vault": "node scripts/compile-vault-fixtures.js",
    "fixtures:vault:check": "node scripts/compile-vault-fixtures.js --check",
    "fixtures:escrow": "node scripts/compile-escrow-fixtures.js",
    "fixtures:escrow:check": "node scripts/compile-escrow-fixtures.js --check",
    "demo:escrow": "node dist/demo-escrow.js",
    "check:public-demo": "node scripts/public-demo-check.js",
    "check:public-demo-deploy": "node scripts/public-demo-deploy-check.js",
    "proof:vault": "node scripts/vault-live.js",
    "proof:vault-commerce": "node scripts/vault-commerce-live.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kaspa-x402/client": "0.1.0-alpha.6",
    "@kaspa-x402/core": "0.1.0-alpha.6",
    "@kaspa-x402/covenant": "0.1.0-alpha.6",
    "@kaspa-x402/server": "0.1.0-alpha.6",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@sd-jwt/core": "0.20.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "jose": "5.10.0",
    "websocket": "^1.0.35",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/websocket": "^1.0.10",
    "typescript": "^5.6.0"
  }
}

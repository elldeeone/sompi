{
  "name": "@elldeeone/sompi",
  "version": "0.11.0",
  "description": "Operator-controlled KAS wallet, transfers, and x402 purchases for local agents on Testnet-10.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elldeeone/sompi.git"
  },
  "keywords": [
    "kaspa",
    "ap2",
    "x402",
    "api",
    "mcp",
    "agent",
    "wallet",
    "transfers",
    "payments",
    "micropayments",
    "model-context-protocol"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "sompi-agent": "dist/agent-main.js",
    "sompi-api": "dist/api-main.js",
    "sompi-authority": "dist/authority-main.js",
    "sompi-mcp": "dist/index.js",
    "sompi-operator": "dist/operator-main.js",
    "sompi-vault-recover": "scripts/vault-recover.js",
    "sompi-verify-authority-isolation": "scripts/verify-authority-isolation.js"
  },
  "files": [
    "CONTEXT.md",
    "CURRENT_STATE.md",
    "LICENSE",
    "contracts",
    "dist",
    "!dist/**/*.test.js",
    "!dist/e2e/**",
    "!dist/e2e-main.js",
    "!dist/adapters/ap2/authority-test-fixtures.js",
    "docs",
    "integrations",
    "!integrations/**/__pycache__/**",
    "!integrations/**/*.pyc",
    "!integrations/**/tests/**",
    "operator.example.json",
    "host-bootstrap.example.json",
    "scripts/package.json",
    "scripts/prepare-package.mjs",
    "scripts/install-runtime-package.mjs",
    "scripts/require-source-tree.mjs",
    "scripts/run-protocol-conformance.mjs",
    "scripts/vault-fixtures.json",
    "scripts/vault-recover.js",
    "scripts/verify-authority-isolation.js",
    "scripts/verify-packed-artifact.mjs",
    "test/conformance",
    "vendor/ap2-v0.2-schemas",
    "vendor/kaspa-x402-alpha.8-conformance",
    "vendor/kaspa-wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/require-source-tree.mjs clean && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/require-source-tree.mjs build && npm run clean && tsc",
    "test": "npm run build && npm run test:unit && SOMPI_SMOKE_OFFLINE=1 npm run smoke",
    "test:unit": "node scripts/require-source-tree.mjs test:unit && node scripts/run-unit-tests.js",
    "test:conformance": "node scripts/run-protocol-conformance.mjs",
    "start": "node dist/api-main.js",
    "mcp:start": "node dist/index.js",
    "openapi:generate": "npm run build && node dist/openapi-main.js generate",
    "openapi:check": "node dist/openapi-main.js check",
    "arazzo:generate": "npm run build && node dist/arazzo-main.js generate",
    "arazzo:check": "node dist/arazzo-main.js check",
    "authority:init": "node dist/authority-main.js init",
    "authority:start": "node dist/authority-main.js",
    "smoke": "node dist/smoke.js",
    "fixtures:vault": "node scripts/require-source-tree.mjs fixtures:vault && node scripts/compile-vault-fixtures.js",
    "fixtures:vault:check": "node scripts/require-source-tree.mjs fixtures:vault:check && node scripts/compile-vault-fixtures.js --check",
    "proof:e2e-local": "node scripts/run-local-e2e.mjs",
    "package:verify": "node scripts/verify-packed-artifact.mjs",
    "prepack": "npm run build && node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@kaspa-x402/client": "0.1.0-alpha.8",
    "@kaspa-x402/core": "0.1.0-alpha.8",
    "@kaspa-x402/covenant": "0.1.0-alpha.8",
    "@kaspa-x402/server": "0.1.0-alpha.8",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/curves": "2.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "12.11.1",
    "jose": "5.10.0",
    "websocket": "1.0.35",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.21",
    "@types/websocket": "1.0.10",
    "typescript": "5.9.3"
  }
}

[Unit]
Description=Cloudflare Tunnel for the sompi demo API
After=network-online.target sompi-service.service
Wants=network-online.target sompi-service.service

[Service]
Type=simple
User=cloudflared
Group=cloudflared
EnvironmentFile=/etc/sompi/cloudflared.env
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token ${CLOUDFLARED_TOKEN}
Restart=on-failure
RestartSec=5

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

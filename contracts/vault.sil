pragma silverscript ^0.1.0;

contract SompiVault(
    pubkey agent,
    pubkey owner,
    int maxOutflow,
    int windowSize,
    int initWindowStart,
    int initSpent
) {
    int windowStart = initWindowStart;
    int spentInWindow = initSpent;

    entrypoint function withdraw(sig agentSig) {
        require(checkSig(agentSig, agent));
        require(tx.inputs.length == 1);
        require(byte[8](OpTxInputSeq(this.activeInputIndex)) == byte[8](0));
        require(tx.outputs.length == 2);

        byte[32] covId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(covId) == 1);
        require(OpCovInputIdx(covId, 0) == this.activeInputIndex);
        require(OpCovOutputCount(covId) == 1);
        int continuationIndex = OpCovOutputIdx(covId, 0);
        require(continuationIndex == 1);

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int changeValue = tx.outputs[continuationIndex].value;
        int outflow = inputValue - changeValue;
        require(outflow >= 0);

        int nextWindowStart = windowStart;
        int nextSpentInWindow = spentInWindow + outflow;
        int inputDaa = OpTxInputDaaScore(this.activeInputIndex);
        if (tx.locktime >= windowStart + windowSize && tx.locktime >= inputDaa + windowSize) {
            nextWindowStart = tx.locktime;
            nextSpentInWindow = outflow;
        }

        require(nextSpentInWindow <= maxOutflow);
        validateOutputState(continuationIndex, { windowStart: nextWindowStart, spentInWindow: nextSpentInWindow });
    }

    entrypoint function topup(sig agentSig) {
        require(checkSig(agentSig, agent));
        require(tx.inputs.length >= 2);
        require(this.activeInputIndex == 0);

        byte[32] covId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(covId) == 1);
        require(OpCovInputIdx(covId, 0) == this.activeInputIndex);
        require(OpCovOutputCount(covId) == 1);
        int continuationIndex = OpCovOutputIdx(covId, 0);
        require(continuationIndex == 0);

        int inputValue = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[continuationIndex].value >= inputValue);
        validateOutputState(continuationIndex, { windowStart: windowStart, spentInWindow: spentInWindow });
    }

    entrypoint function recover(sig ownerSig) {
        require(checkSig(ownerSig, owner));
    }
}
